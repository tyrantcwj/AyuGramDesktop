[Desktop Entry]
Name=iTycTG Desktop
Comment=Desktop version of iTycTG - ToS breaking Telegram client
TryExec=iTycTG
Exec=env DESKTOPINTEGRATION=1 iTycTG -- %U
Icon=com.ityctg.desktop
Terminal=false
StartupWMClass=iTycTG
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
Keywords=tg;chat;im;messaging;messenger;sms;telegram;tdesktop;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=iTycTG -quit
Name=Quit iTycTG
Icon=application-exit
